#!/usr/bin/env bash
# Fake nix-collect-garbage for tnxstor integration tests.
if [ -n "$TNXS_TEST_LOG" ]; then echo "nix-collect-garbage $*" >> "$TNXS_TEST_LOG"; fi
case "$1" in
  -d)
    echo "removing old generations from /nix/var/nix/profiles..."
    echo "321 store paths deleted, 7.88 GiB freed"
    ;;
  *)
    echo "fake nix-collect-garbage: unhandled args: $*" >&2
    exit 1
    ;;
esac
